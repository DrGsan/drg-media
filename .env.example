# Generate with: python -m family_photo.cli generate-token
# Match FAMILY_PHOTO_TOKEN in DrG Space. Never commit the real .env.
FP_SERVICE_TOKEN=
FP_DATA_DIR=./data
# Empty uses this service's own archive.sqlite3. Never point at DrG Space's DB.
FP_DATABASE_URL=
# Optional metadata cache. Empty disables Redis; no Redis server is required.
# Upgrade all API/workers before enabling; keep Redis private.
# redis://user:password@private-host:6379/0 or rediss:// for verified TLS.
FP_REDIS_URL=
FP_REDIS_CACHE_TTL=30
FP_STORAGE=local
# Optional separate private S3 bucket: text, photo/video originals and thumbnails.
FP_S3_BUCKET=
FP_S3_ENDPOINT_URL=
FP_S3_REGION=us-east-1
FP_S3_PREFIX=family-photo
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# From my.telegram.org -> API development tools. Login is an interactive command.
FP_TELEGRAM_API_ID=
FP_TELEGRAM_API_HASH=
# Legacy upgrade only: imported once into owner-managed registry, then remove.
# FP_TELEGRAM_GROUPS=
# Explicit verified mapping: {"-1001234567890":"export:0123456789abcdef"}
# Keep {} unless message IDs and dates have been compared with an existing export.
# FP_TELEGRAM_ARCHIVE_BINDINGS={}
FP_BOT_TOKEN=
# Complete verification of known IDs, in bounded batches. Never infer deletion on network errors.
FP_RECONCILE_SECONDS=86400
FP_PAGE_DELAY=1
# Optional compose.postgres.yaml; use a URL-safe generated password.
FP_POSTGRES_PASSWORD=
# Optional compose.site.yaml; inspect the site's actual Docker network name first.
DRG_SITE_NETWORK=drg-site_default
